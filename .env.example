# ClipRing Environment Configuration

# Directory to save captured images and files
CLIPRING_SAVE_DIR=~/Pictures/ClipRing

# AutoSaver polling frequency in seconds (default: 0.5)
CLIPRING_POLL_INTERVAL=0.5

# Convert animated WebP captures directly to GIF (default: true)
CLIPRING_CONVERT_WEBP_TO_GIF=true

# Desktop notifications enabled (default: true)
CLIPRING_NOTIFICATIONS=true

# Sanitization / Redaction: mask tokens, API keys, passwords in history and logs
CLIPRING_SANITIZE=true

# Optional AI Integration (only if using clipring[ai])
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLIPRING_AI_MODEL=gpt-4o
